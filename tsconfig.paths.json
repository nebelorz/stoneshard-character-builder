{
  "compilerOptions": {
    "baseUrl": "src",
    "paths": {
      "@shared/*": ["app/shared/*"],
      "@shared": ["app/shared/index.ts"],
      "@core/*": ["app/core/*"],
      "@core/state": ["app/core/state/index.ts"],
      "@core/data": ["app/core/data/index.ts"],
      "@features/*": ["app/features/*"],
      "@features/build/services": ["app/features/build/services/index.ts"],
      "@models/*": ["app/models/*"],
